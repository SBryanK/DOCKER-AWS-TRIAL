# ---------------------------------------------------------------------------
# Runtime mode
#   local   = fully offline: hashed lexical embeddings + extractive answers.
#             Great for Docker demos, CI and interviews without AWS spend.
#   bedrock = real Amazon Bedrock calls (needs AWS credentials on the host).
# ---------------------------------------------------------------------------
EMBEDDINGS_PROVIDER=local
LLM_PROVIDER=local

# ---------------------------------------------------------------------------
# AWS (only used when a provider above is "bedrock")
# Credentials stay on your machine: mount ~/.aws read-only at runtime or use
# `aws configure sso`. Never copy keys into this repo or the image.
# ---------------------------------------------------------------------------
AWS_REGION=ap-southeast-1
# AWS_PROFILE=your-sso-profile

# Embeddings. Titan Text Embeddings V2 is the requested choice, but AWS docs
# currently disagree about its availability in ap-southeast-1 (the Singapore
# price list lists it, the model card does not). Verify with:
#   python -m scripts.check_bedrock
# Verified in-region fallback: cohere.embed-multilingual-v3 (1024 dims).
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_STYLE=auto          # auto | titan | cohere
EMBEDDING_DIM=1024            # Titan: 256/512/1024 · Cohere multilingual: 1024

# Text generation. `apac.amazon.nova-lite-v1:0` is the confirmed cheap model
# available from Singapore via the APAC cross-region inference profile.
LLM_MODEL_ID=apac.amazon.nova-lite-v1:0

# ---------------------------------------------------------------------------
# Vector store: numpy (single process, persisted to disk) or qdrant (compose)
# ---------------------------------------------------------------------------
VECTOR_BACKEND=numpy
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=policy_chunks

# ---------------------------------------------------------------------------
# Retrieval and chunking
# ---------------------------------------------------------------------------
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=4
MIN_SCORE=0.10

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
DATA_DIR=data
LOG_LEVEL=INFO
